{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/videos",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "5,20,35,50 * * * *"
    }
  ]
}
